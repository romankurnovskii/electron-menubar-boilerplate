{
  "name": "electron-menubar-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/electron/main.js",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "electron:dev": "concurrently \"npm run start\" \"tsc -p electron --skipLibCheck -w\" \"tsc -p electron/preload/tsconfig.json --skipLibCheck -w\" \"wait-on http://localhost:5174 build/electron/main.js build/electron/preload/preload.cjs && electron .\"",
    "electron:build": "npm run build && tsc -p electron --skipLibCheck && tsc -p electron/preload/tsconfig.json --skipLibCheck && electron-builder",
    "electron:dist": "npm run build && tsc -p electron --skipLibCheck && tsc -p electron/preload/tsconfig.json --skipLibCheck && electron-builder --mac --dir"
  },
  "dependencies": {
    "electron-devtools-installer": "^4.0.0",
    "electron-reload": "2.0.0-alpha.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/electron-devtools-installer": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "productName": "productName",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "universal"
        ]
      },
      "category": "public.app-category.productivity"
    },
    "extends": null,
    "files": [
      "build/**/*",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ]
  }
}
